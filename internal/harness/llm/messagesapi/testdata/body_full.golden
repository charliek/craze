{
  "model": "claude-opus-5-5",
  "max_tokens": 64000,
  "stream": true,
  "thinking": {
    "type": "adaptive",
    "display": "summarized",
    "block_binding": {
      "prefix_mismatch_behavior": "drop_block"
    }
  },
  "output_config": {
    "effort": "medium"
  },
  "cache_control": {
    "type": "ephemeral"
  },
  "system": [
    {
      "type": "text",
      "text": "You are craze."
    },
    {
      "type": "text",
      "text": "Project notes: <none> & more.",
      "cache_control": {
        "type": "ephemeral"
      }
    }
  ],
  "tools": [
    {
      "name": "read",
      "description": "Read a file.",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "name": "noop",
      "input_schema": {
        "type": "object",
        "properties": {}
      }
    }
  ],
  "tool_choice": {
    "type": "none"
  },
  "messages": [
    {
      "role": "user",
      "content": [
        {
          "type": "text",
          "text": "Read go.mod <now> & tell me."
        },
        {
          "type": "image",
          "source": {
            "type": "base64",
            "media_type": "image/png",
            "data": "iVBORw0KGgpub3QtcmVhbGx5"
          }
        }
      ]
    },
    {
      "role": "assistant",
      "content": [
        {
          "type": "thinking",
          "thinking": "",
          "signature": "sig-empty-text"
        },
        {
          "type": "thinking",
          "thinking": "Which file?",
          "signature": "sig-1"
        },
        {
          "type": "redacted_thinking",
          "data": "opaque-redacted"
        },
        {
          "type": "text",
          "text": "Reading."
        },
        {
          "type": "tool_use",
          "id": "toolu_01",
          "name": "read",
          "input": {
            "path": "go.mod"
          }
        },
        {
          "type": "tool_use",
          "id": "toolu_02",
          "name": "noop",
          "input": {}
        }
      ]
    },
    {
      "role": "user",
      "content": [
        {
          "type": "tool_result",
          "tool_use_id": "toolu_01",
          "content": [
            {
              "type": "text",
              "text": "module x"
            }
          ]
        },
        {
          "type": "tool_result",
          "tool_use_id": "toolu_02",
          "content": [
            {
              "type": "text",
              "text": "noop failed"
            }
          ],
          "is_error": true
        },
        {
          "type": "tool_result",
          "tool_use_id": "toolu_03"
        },
        {
          "type": "tool_result",
          "tool_use_id": "toolu_04",
          "content": [
            {
              "type": "text",
              "text": "a picture"
