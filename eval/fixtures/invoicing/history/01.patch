+from decimal import Decimal
+
+from export import to_csv
+from invoice import Line
+
+
+def test_to_csv():
+    text = to_csv([Line("NB-A5", 2, Decimal("4.50"))])
+    rows = text.splitlines()
+    assert rows[1] == "NB-A5,2,4.50,9.00"
+    assert len(rows) == 2
