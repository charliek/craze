new file mode 100644
index 0000000..2e9bde4
--- /dev/null
+++ b/export.py
@@ -0,0 +1,17 @@
+"""CSV export of invoice lines."""
+
+import csv
+import io
+from decimal import ROUND_HALF_UP
+
+from invoice import CENT, Line
+
+
+def to_csv(lines: list[Line]) -> str:
+    out = io.StringIO()
+    writer = csv.writer(out, lineterminator="\n")
+    writer.writerow(["sku", "quanity", "unit_price", "amount"])
+    for line in lines:
+        amount = (line.unit_price * line.quantity).quantize(CENT, rounding=ROUND_HALF_UP)
+        writer.writerow([line.sku, line.quantity, line.unit_price, amount])
+    return out.getvalue()
