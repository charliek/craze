diff --git a/invoice.py b/invoice.py
index 4b37d48..dbc9910 100644
--- a/invoice.py
+++ b/invoice.py
@@ -28,6 +28,15 @@ def apply_discount(amount: Decimal, percent: Decimal) -> Decimal:
     return amount * (Decimal("100") - percent) / Decimal("100")
 
 
-def total(lines: list[Line], discount_percent: Decimal = Decimal("0")) -> Decimal:
-    """The amount due, rounded to cents."""
-    return _round(apply_discount(subtotal(lines), discount_percent))
+def apply_tax(amount: Decimal, percent: Decimal) -> Decimal:
+    """Add ``percent`` tax to ``amount``."""
+    return amount * (Decimal("100") + percent) / Decimal("100")
+
+
+def total(
+    lines: list[Line],
+    discount_percent: Decimal = Decimal("0"),
+    tax_percent: Decimal = Decimal("0"),
+) -> Decimal:
+    """The amount due, rounded to cents: discount first, then tax."""
+    return _round(apply_tax(apply_discount(subtotal(lines), discount_percent), tax_percent))
diff --git a/tax.py b/tax.py
new file mode 100644
index 0000000..2e9eb7f
--- /dev/null
+++ b/tax.py
@@ -0,0 +1,15 @@
+"""Tax rates by customer region, in percent."""
+
+from decimal import Decimal
+
+RATES = {
+    "default": Decimal("0"),
+    "CA": Decimal("7.25"),
+    "NY": Decimal("4"),
+    "TX": Decimal("6.25"),
+}
+
+
+def rate_for(region: str | None) -> Decimal:
+    """The tax rate for a customer's region (the default when unknown)."""
+    return RATES.get(region or "default", RATES["default"])
