+        # One Orvelline-Dedup-Key per booking, so a held booking can be finished: on 409
+        # booking.hold_pending, wait details.settle_cs (centiseconds) and promptly resend the
+        # same body with the same key plus Orvelline-Resume-Hold: <details.quota_claim>, for
+        # as long as that is the answer (the claim ends in a booking or another error).
+        headers = {"Orvelline-Dedup-Key": str(uuid.uuid4())}
+        while True:
+            try:
+                out = self._request("POST", "/v2/pass-bookings", body, headers)
+            except OrvellineError as e:
+                claim, wait_cs = e.details.get("quota_claim"), e.details.get("settle_cs")
+                if e.status != 409 or e.code != "booking.hold_pending" or not claim or wait_cs is None:
+                    raise
+                time.sleep(wait_cs / 100)
+                headers = {**headers, "Orvelline-Resume-Hold": claim}
+                continue
+            return Booking.from_json(out["booking"])

 
