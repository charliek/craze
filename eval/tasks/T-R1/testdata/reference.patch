@@ -9,6 +9,17 @@ EMAIL_RE = re.compile(r"[a-z0-9._%+-]+@[a-z0-9-]+(\.[a-z0-9-]+)+")
 BLOCKED_DOMAINS = {"mailinator.com", "example.invalid", "tempmail.dev"}
 
 
+def normalise_email(email: str) -> str:
+    """The canonical form of an address: stripped and lower-cased. Raises
+    ValueError when it is not a valid address or its domain is blocked."""
+    email = email.strip().lower()
+    if not EMAIL_RE.fullmatch(email):
+        raise ValueError(f"invalid email address: {email!r}")
+    if email.rsplit("@", 1)[1] in BLOCKED_DOMAINS:
+        raise ValueError(f"email domain not allowed: {email!r}")
+    return email
+
+
 @dataclass
 class User:
     id: int
