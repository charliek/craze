+package humanize
+
+import (
+	"math"
+	"strconv"
+	"strings"
+)
+
+var byteUnits = []string{"KiB", "MiB", "GiB", "TiB", "PiB", "EiB"}
+
+// Bytes formats a byte count with binary units: "0 B", "1023 B", "1 KiB",
+// "1.5 KiB", "2.3 GiB". Above 1023 bytes the value is shown in the largest unit
+// in which it is at least 1, rounded to one decimal (halves away from zero),
+// without a trailing ".0"; a value that rounds to 1024 of a unit moves to the
+// next. A negative count gets a leading minus.
+func Bytes(n int64) string {
+	if n < 0 {
+		if n == math.MinInt64 {
+			return "-8 EiB"
+		}
+		return "-" + Bytes(-n)
+	}
+	if n < 1024 {
+		return strconv.FormatInt(n, 10) + " B"
+	}
+	v := float64(n) / 1024
+	unit := 0
+	for v >= 1024 && unit < len(byteUnits)-1 {
+		v /= 1024
+		unit++
+	}
+	r := math.Round(v*10) / 10
+	if r >= 1024 && unit < len(byteUnits)-1 {
+		unit++
+		r = math.Round(r/1024*10) / 10
+	}
+	s := strconv.FormatFloat(r, 'f', 1, 64)
+	return strings.TrimSuffix(s, ".0") + " " + byteUnits[unit]
+}
