@@ -0,0 +1,24 @@
+package humanize
+
+import "testing"
+
+func TestBytes(t *testing.T) {
+	cases := []struct {
+		in   int64
+		want string
+	}{
+		{0, "0 B"},
+		{1023, "1023 B"},
+		{1024, "1 KiB"},
+		{1536, "1.5 KiB"},
+		{1 << 20, "1 MiB"},
+		{1048575, "1 MiB"},
+		{3 << 30, "3 GiB"},
+		{-1536, "-1.5 KiB"},
+	}
+	for _, c := range cases {
+		if got := Bytes(c.in); got != c.want {
+			t.Errorf("Bytes(%d) = %q, want %q", c.in, got, c.want)
+		}
+	}
+}
