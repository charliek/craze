+A total row is printed when more than one file is given.
+
+`--json` prints the same counts as one JSON object instead of the table: `files` (a list of
+`{"path", "lines", "words", "chars"}` in the order given) and `total`, always present:
+
+```shell
+python wordstat.py --json notes.md todo.txt
+```
+
+Tests: `pytest`.
diff --git a/tests/test_wordstat_json.py b/tests/test_wordstat_json.py
new file mode 100644
index 0000000..7c81f8b
--- /dev/null
+++ b/tests/test_wordstat_json.py
@@ -0,0 +1,23 @@
+import json
+
+from wordstat import main
+
+
+def test_json_output(tmp_path, capsys):
+    a, b = tmp_path / "a.txt", tmp_path / "b.txt"
+    a.write_text("x\n")
+    b.write_text("y z\nw\n")
+    assert main(["--json", str(a), str(b)]) == 0
+    doc = json.loads(capsys.readouterr().out)
+    assert doc["files"] == [
+        {"path": str(a), "lines": 1, "words": 1, "chars": 2},
+        {"path": str(b), "lines": 2, "words": 3, "chars": 6},
+    ]
+    assert doc["total"] == {"lines": 3, "words": 4, "chars": 8}
+
+
+def test_json_single_file_has_a_total(tmp_path, capsys):
+    a = tmp_path / "a.txt"
+    a.write_text("one two\n")
+    assert main([str(a), "--json"]) == 0
+    assert json.loads(capsys.readouterr().out)["total"] == {"lines": 1, "words": 2, "chars": 8}
