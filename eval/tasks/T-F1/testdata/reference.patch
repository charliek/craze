+def as_json(rows: list[tuple[str, Counts]]) -> str:
+    total = sum((c for _, c in rows), Counts())
+    doc = {
+        "files": [{"path": path, "lines": c.lines, "words": c.words, "chars": c.chars} for path, c in rows],
